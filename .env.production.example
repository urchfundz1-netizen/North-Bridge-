# Production settings.
#
# For the Firebase Function: copy this to server/.env on the deploy machine
# (never commit it - .env is git-ignored). Firebase uploads it with
# `firebase deploy --only functions` and injects it into process.env at runtime.
# For a systemd/VPS run of `server/src/index.js`: copy to .env in the repo root.
# The app reads .env automatically and crashes on boot if production values
# are missing or still placeholders (SESSION_SECRET, CLIENT_ORIGIN).

# Public HTTPS origin of the browser client. MUST match exactly how the SPA is
# reached - with the client on Vercel this is the Vercel domain.
CLIENT_ORIGIN=https://<your-vercel-app>.vercel.app

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-48-random-bytes-as-hex

ADMIN_EMAIL=admin@northbridge.bank
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional banking rules (defaults shown against .env.example).
# REQUIRE_TRANSFER_APPROVAL=1
# TRANSFER_FEE_CENTS=150
# MIN_TRANSFER_CENTS=100
# MAX_TRANSFER_CENTS=50000000
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com