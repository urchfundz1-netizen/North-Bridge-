# Production settings for a VPS deploy. Copy to .env in the repo root and edit:
#   cp .env.production.example .env
# The app reads .env automatically and crashes on boot if production values
# are missing or still placeholders (SESSION_SECRET, CLIENT_ORIGIN). Never
# commit the real file - .env is git-ignored.

# Public HTTPS origin. Must match exactly how a browser reaches the app,
# i.e. https://<your-domain>. See .env.example for the full list of options.
CLIENT_ORIGIN=https://bank.example.com

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-48-random-bytes-as-hex

ADMIN_EMAIL=admin@northbridge.bank
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional banking rules (defaults shown against .env.example).
# REQUIRE_TRANSFER_APPROVAL=1
# TRANSFER_FEE_CENTS=150
# MIN_TRANSFER_CENTS=100
# MAX_TRANSFER_CENTS=50000000
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com