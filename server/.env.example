# Production environment for the Cloud Function (loaded by Firebase at deploy).
# Copy to server/.env (gitignored) and fill in real values before:
#   firebase deploy --only functions
#
# Why server/.env and not the root .env? Cloud Functions ships only the
# server/ directory; Firebase reads .env files in the functions source and
# injects them into process.env at runtime.

# The Vercel URL of the deployed client, e.g. https://your-app.vercel.app
# CORS and the session cookie are both scoped to this origin.
CLIENT_ORIGIN=

# A long random string (openssl rand -hex 32). Must NOT start with "dev-only".
SESSION_SECRET=

# 1 - required: the client (Vercel) and API (cloudfunctions.net) are HTTPS
COOKIE_SECURE=1

# none - required for split-domain deployment; the browser withholds
# SameSite=strict cookies on cross-site requests, which silently breaks login.
COOKIE_SAMESITE=none

# Admin bootstrap (used by npm run seed:admin; login itself uses the seeded
# admins collection)
ADMIN_EMAIL=admin@northbridge.bank
ADMIN_PASSWORD=ChangeMe_Admin#2024
ADMIN_FULL_NAME=System Administrator

# Optional session lifetime overrides (hours)
# SESSION_TTL_HOURS=12
# ADMIN_SESSION_TTL_HOURS=8
