# ---------------------------------------------------------------------------
# Northbridge Bank - environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public origin of the browser client. Used for CORS and cookie behaviour.
# This is the one value that MUST change for a real deploy, and leaving it alone
# fails silently: the server answers every response with the wrong
# Access-Control-Allow-Origin, so the page loads and then cannot sign in, with
# nothing wrong in the server logs. So the server refuses to boot with
# NODE_ENV=production while this is still a loopback address.
# If the API also serves the built client, set this to that same origin.
# ALLOW_LOOPBACK_ORIGIN=1  overrides the check on purpose (local rehearsal).
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Sessions / cookies
# Generate fresh random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=dev-only-change-me-session-secret-0000000000000000
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8

# Set to 1 only when serving over HTTPS. Keeps cookies Secure in production.
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_FILE=./data/northbridge.db

# ---------------------------------------------------------------------------
# Bootstrap administrator (used only by `npm run seed:admin`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@northbridge.bank
ADMIN_PASSWORD=ChangeMe_Admin#2024
ADMIN_FULL_NAME=System Administrator

# ---------------------------------------------------------------------------
# Transfer / banking rules
# Require administrator approval before a transfer debits the balance.
#   1 = transfers stay Pending until an admin approves them
#   0 = transfers settle immediately (still recorded in the ledger)
# ---------------------------------------------------------------------------
REQUIRE_TRANSFER_APPROVAL=1

# Flat fee (in minor units / cents) added to outbound transfers.
TRANSFER_FEE_CENTS=150

# Guard rails
MIN_TRANSFER_CENTS=100
MAX_TRANSFER_CENTS=50000000
MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# Firebase / Firestore mirror (optional, server-side only via firebase-admin)
# SQLite stays the source of truth; committed rows are mirrored to Firestore.
# Leave FIREBASE_ENABLED unset/0 to turn the mirror off entirely.
#
# Get the three values from:
#   Firebase console -> Project settings -> Service accounts
#   -> "Generate new private key" (JSON file; copy project_id, client_email,
#   private_key). Keep the private key on ONE line inside double quotes with
#   the literal \n sequences intact - the loader converts them to newlines.
# ---------------------------------------------------------------------------
FIREBASE_ENABLED=0
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
